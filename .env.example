# Public social OAuth activation flags only.
# Provider client secrets belong in Supabase Dashboard, not in app env.
EXPO_PUBLIC_ENABLE_GOOGLE_OAUTH=true
EXPO_PUBLIC_ENABLE_KAKAO_OAUTH=true
EXPO_PUBLIC_ENABLE_NAVER_OAUTH=false
EXPO_PUBLIC_ENABLE_WALK_POI_RPC=true
EXPO_PUBLIC_ENABLE_WALK_POI_FALLBACK_GATE=true
